{
  "name": "tmg_video_player",
  "productName": "TMG Video Player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TVP is a simple video player that allows you to play videos from your local device in your web browser.",
  "author": "Oketade Oluwatobiloba <tobioketade007@gmail.com>",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "vercel dev --listen 5173",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron . --dev",
    "electron": "electron .",
    "pack": "vite build --outDir build && electron-builder --win"
  },
  "build": {
    "appId": "com.tmg.videoplayer",
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tobi007-del/TMG_VIDEO_PLAYER.git"
  },
  "keywords": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tobi007-del/TMG_VIDEO_PLAYER/issues"
  },
  "homepage": "https://github.com/Tobi007-del/TMG_VIDEO_PLAYER#readme",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@t007/dialog": "^0.0.36",
    "@t007/input": "^0.0.35",
    "@t007/toast": "^0.0.36",
    "@t007/utils": "^0.0.37",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "sia-reactor": "^0.0.40",
    "tmg-media-player": "^0.0.18"
  }
}
